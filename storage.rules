rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Helper functions
    function isAuth() {
      return request.auth != null;
    }

    // Media uploads - authenticated users can upload images/videos
    match /media/{allPaths=**} {
      allow read: if true;
      allow write: if isAuth()
                   && request.resource.size < 50 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*|video/.*');
    }

    // Player documents - coaches+ can upload
    match /players/{allPaths=**} {
      allow read: if isAuth();
      allow write: if isAuth()
                   && request.resource.size < 20 * 1024 * 1024;
    }

    // Organization documents
    match /documents/{allPaths=**} {
      allow read: if isAuth();
      allow write: if isAuth()
                   && request.resource.size < 20 * 1024 * 1024;
    }

    // Homepage post images
    match /homepage/{allPaths=**} {
      allow read: if true;
      allow write: if isAuth()
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // Sponsor logos
    match /sponsors/{allPaths=**} {
      allow read: if true;
      allow write: if isAuth()
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // Guest evaluator media — evaluators upload via their invite link without
    // an account, so the unguessable token UUID in the path is the credential.
    // Size/type limited; reads are public (URLs surface in coach report cards).
    match /evalMedia/{token}/{allPaths=**} {
      allow read: if true;
      allow write: if request.resource.size < 100 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*|video/.*');
    }

    // Default deny
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
