rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuth() {
      return request.auth != null;
    }

    function isUser(userId) {
      return isAuth() && request.auth.uid == userId;
    }

    function getUserData(userId) {
        return get(/databases/$(database)/documents/users/$(userId)).data
    }

    function hasRole(role) {
      let data = getUserData(request.auth.uid);
      return ('roles' in data && data.roles.hasAny([role])) ||
             ('role' in data && data.role == role);
    }

    function isMasterAdmin() {
      return isAuth() && hasRole('master-admin');
    }

    function isAdmin() {
      return isAuth() && (hasRole('admin') || hasRole('master-admin'));
    }

    function isCoach() {
      return isAuth() && (hasRole('coach') || isAdmin());
    }

    function isSponsor() {
      return isAuth() && hasRole('sponsor');
    }

    // SITE SETTINGS (org name, logo, etc.)
    match /siteSettings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // PUBLIC COLLECTIONS
    match /news/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // PLAYERS — public read for roster pages (public pages only expose safe fields:
    // firstName, lastInitial, jerseyNumber, positions). PII fields like contacts
    // and medical info should be filtered at the application level.
    match /players/{playerId} {
      allow read: if true;
      allow write: if isCoach();
    }

    match /teams/{docId} {
      allow read: if true;
      allow write: if isCoach();
    }

    match /seasons/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /games/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // USER DATA
    match /users/{userId} {
      allow read: if isAuth();
      allow create: if (isAuth() && request.auth.uid == userId && !('roles' in request.resource.data && request.resource.data.roles.hasAny(['admin', 'master-admin']))) || isAdmin();
      // Users can update their own profile, but ONLY admins can change roles
      allow update: if isAdmin() || (
        isUser(userId) &&
        (!('roles' in request.resource.data) || request.resource.data.roles == resource.data.roles) &&
        (!('role' in request.resource.data) || request.resource.data.role == resource.data.role)
      );
      allow delete: if isMasterAdmin();
    }

    // PENDING USERS (admin-managed user provisioning)
    match /pendingUsers/{docId} {
      allow read, write: if isAdmin();
    }

    // TRYOUTS
    match /tryout-applicants/{applicantId} {
      allow read: if isCoach();
      allow create: if true;
      allow update: if isCoach();

      match /evaluations/{evaluationId} {
        allow read, write: if isCoach();
      }
    }

    // COMMUNICATIONS
    match /communications/{messageId} {
      allow create: if isAdmin();
      allow read: if isAuth() && request.auth.uid in resource.data.recipients;
      allow write: if false;
    }

    // SPONSORS
    match /sponsors/{docId} {
      allow read: if true;
      // Only admins and sponsor-role users can create; webhook creates via Admin SDK
      allow create: if isAdmin() || isSponsor();
      allow update: if isAdmin() || (isSponsor() && resource.data.userId == request.auth.uid);
      allow delete: if isAdmin();
    }

    // SCHEDULES / EVENTS
    match /schedules/{docId} {
      allow read: if true;
      allow write: if isCoach();
    }

    // ANNOUNCEMENTS
    match /announcements/{docId} {
      allow read: if isAuth();
      allow write: if isCoach();
    }

    // CONVERSATIONS & MESSAGES
    match /conversations/{convoId} {
      allow read: if isAuth() && request.auth.uid in resource.data.participantIds;
      // Creator must be a participant in the conversation
      allow create: if isAuth() && request.auth.uid in request.resource.data.participantIds;
      allow update: if isAuth() && request.auth.uid in resource.data.participantIds;

      match /messages/{messageId} {
        allow read, create: if isAuth() && request.auth.uid in get(/databases/$(database)/documents/conversations/$(convoId)).data.participantIds;
      }
    }

    // DOCUMENTS (role-based visibility)
    match /documents/{docId} {
      allow read: if isAuth() && (
        isAdmin() ||
        (isCoach() && resource.data.visibility in ['public', 'parent', 'coach', 'team']) ||
        (hasRole('parent') && resource.data.visibility in ['public', 'parent']) ||
        resource.data.visibility == 'public'
      );
      allow write: if isCoach();
    }

    // MEDIA
    match /media/{docId} {
      allow read: if true;
      allow write: if isCoach();
    }

    // TOURNAMENTS
    match /tournaments/{docId} {
      allow read: if isAuth();
      allow write: if isAdmin();
    }

    // VOLUNTEERS
    match /volunteers/{docId} {
      allow read: if isAuth();
      allow write: if isCoach();
    }

    // FUNDRAISERS
    match /fundraisers/{docId} {
      allow read: if isAuth();
      allow write: if isAdmin();
    }

    // PLAYER FINANCES
    // Parents can read finance records for their linked children; sponsors can read for sponsored players
    match /playerFinances/{docId} {
      allow read: if isCoach() || isSponsor() || (
        isAuth() && hasRole('parent') &&
        resource.data.playerId in getUserData(request.auth.uid).linkedPlayerIds
      );
      allow write: if isAdmin();
    }

    // EXPENSES
    match /expenses/{docId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // INCOME
    // Sponsors can read their own sponsorship income records
    match /income/{docId} {
      allow read: if isAdmin() || (
        isSponsor() && resource.data.category == 'sponsorships'
      );
      allow write: if isAdmin();
    }

    // COST ASSUMPTIONS
    // The 'global' document is publicly readable for the pricing page;
    // all other cost docs require admin access.
    match /costs/global {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /costs/{docId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // BUDGETS
    match /budgets/{docId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // ACCOUNTS
    match /accounts/{docId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // VENDORS
    match /vendors/{docId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // PLAYER METRICS
    match /playerMetrics/{docId} {
      allow read: if isCoach();
      allow write: if isCoach();
    }

    // SCHOLARSHIPS
    match /scholarships/{docId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // EQUIPMENT
    match /equipment/{docId} {
      allow read: if isCoach();
      allow write: if isAdmin();
    }

    // INVOICE TOKENS (QR code payments)
    // Public read so payment page works; only admins and cloud functions can create/update.
    // The markUsed call is done by cloud function (stripe webhook), not client-side.
    match /invoiceTokens/{docId} {
      allow read: if true;
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // MAIL (receipt emails via Firebase Trigger Email extension)
    match /mail/{docId} {
      allow create: if isAdmin();
      allow read: if isAdmin();
    }

    // RECEIPTS (fallback receipt storage)
    match /receipts/{docId} {
      allow create: if isAdmin();
      allow read: if isAdmin();
    }

    // CONTACT FORM SUBMISSIONS
    match /contactSubmissions/{docId} {
      allow read: if isAdmin();
      allow create: if true;
    }

    // APP SETTINGS
    match /appSettings/{docId} {
      allow read: if isAuth();
      allow write: if isAdmin();
    }

    // ADMIN NOTIFICATIONS (content moderation alerts)
    match /adminNotifications/{docId} {
      allow read, write: if isAdmin();
    }

    // HOMEPAGE POSTS (public-facing content)
    match /homepagePosts/{docId} {
      allow read: if true;
      allow create: if isCoach();
      allow update: if isCoach();
      allow delete: if isAdmin();
    }

    // GAMECHANGER DATA
    match /gcStats/{docId} {
      allow read: if isCoach();
      allow write: if isAdmin();
    }

    match /gcGames/{docId} {
      allow read: if isCoach();
      allow write: if isAdmin();
    }

    // COST ITEMS (3-tier cost management)
    match /costItems/{docId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // CHART OF ACCOUNTS
    match /chartOfAccounts/{docId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // GENERAL LEDGER
    match /generalLedger/{docId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // TEAM INVOICE BATCHES
    match /teamInvoiceBatches/{docId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // DONORS
    match /donors/{docId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // DONOR RECEIPTS
    match /donorReceipts/{docId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // BOARD MEETINGS
    match /boardMeetings/{docId} {
      allow read: if isCoach();
      allow write: if isAdmin();
    }

    // GOVERNANCE DOCUMENTS
    match /governanceDocuments/{docId} {
      allow read: if isCoach();
      allow write: if isAdmin();
    }

    // VOLUNTEER HOURS
    match /volunteerHours/{docId} {
      allow read: if isCoach();
      allow write: if isCoach();
    }

    // BACKGROUND CHECKS
    match /backgroundChecks/{docId} {
      allow read: if isCoach();
      allow write: if isAdmin();
    }

    // FORM 990 DATA
    match /form990Data/{docId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // TEAM STATS (imported via scripts, read by coaches+)
    match /teamStats/{docId} {
      allow read: if isCoach();
      allow write: if isAdmin();
    }

    // PASSWORD RESETS (server-only via Admin SDK — deny all client access)
    match /passwordResets/{docId} {
      allow read, write: if false;
    }

    // RATE LIMITS (server-only via Admin SDK — deny all client access)
    match /rateLimits/{docId} {
      allow read, write: if false;
    }

    // FISCAL YEAR CLOSES (admin only — year-end closing records)
    match /fiscalYearCloses/{docId} {
      allow read: if isAdmin();
      allow write: if isMasterAdmin();
    }

    // FIXED ASSETS (admin only — depreciation tracking)
    match /fixedAssets/{docId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // BANK RECONCILIATIONS (admin only)
    match /bankReconciliations/{docId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }
  }
}
