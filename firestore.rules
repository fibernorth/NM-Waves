rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuth() {
      return request.auth != null;
    }

    function isUser(userId) {
      return isAuth() && request.auth.uid == userId;
    }

    function getUserData(userId) {
        return get(/databases/$(database)/documents/users/$(userId)).data
    }

    function hasRole(role) {
      let data = getUserData(request.auth.uid);
      return ('roles' in data && data.roles.hasAny([role])) ||
             ('role' in data && data.role == role);
    }

    function isMasterAdmin() {
      return isAuth() && hasRole('master-admin');
    }

    function isAdmin() {
      return isAuth() && (hasRole('admin') || hasRole('master-admin'));
    }

    function isCoach() {
      return isAuth() && (hasRole('coach') || isAdmin());
    }

    function isSponsor() {
      return isAuth() && hasRole('sponsor');
    }

    // SITE SETTINGS (org name, logo, etc.)
    match /siteSettings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // PUBLIC COLLECTIONS
    match /news/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // PLAYERS — sensitive minor PII (DOB, medical notes, emergency contacts).
    // Readable ONLY by coaches/admins and by a parent for their own linked
    // children — not by arbitrary logged-in users. Public roster pages use the
    // getPublicRoster Cloud Function (safe fields only); the child-link search
    // uses searchLinkablePlayers (no PII). linkedPlayerIds is verified and
    // frozen against client writes (see users rule below), so it is trustworthy.
    match /players/{playerId} {
      allow read: if isCoach() || (
        isAuth() && hasRole('parent') &&
        playerId in getUserData(request.auth.uid).linkedPlayerIds
      );
      allow write: if isCoach();
    }

    match /teams/{docId} {
      allow read: if true;
      allow write: if isCoach();
    }

    match /seasons/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /games/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // USER DATA
    // Self-signup may ONLY create a parent (or role-less) account. Any privileged
    // role — coach, admin, master-admin, sponsor — must be granted by an admin
    // via provisioning; it can never be self-assigned at signup. This closes the
    // escalation where anyone could register as 'coach' and gain roster/PII access.
    match /users/{userId} {
      allow read: if isAuth();
      allow create: if isAdmin() || (
        isAuth() && request.auth.uid == userId &&
        (!('roles' in request.resource.data) || request.resource.data.roles == ['parent']) &&
        (!('role' in request.resource.data) || request.resource.data.role == 'parent')
      );
      // Users can update their own profile, but ONLY admins can change roles,
      // and linkedPlayerIds is frozen for non-admins — parents link children
      // through the verified linkChild Cloud Function (Admin SDK), never by
      // writing their own doc. This keeps linkedPlayerIds trustworthy as the
      // gate for reading a child's sensitive data and finances.
      allow update: if isAdmin() || (
        isUser(userId) &&
        (!('roles' in request.resource.data) || request.resource.data.roles == resource.data.roles) &&
        (!('role' in request.resource.data) || request.resource.data.role == resource.data.role) &&
        (!('linkedPlayerIds' in request.resource.data) || request.resource.data.linkedPlayerIds == resource.data.linkedPlayerIds)
      );
      allow delete: if isMasterAdmin();
    }

    // PENDING USERS (admin-managed user provisioning)
    match /pendingUsers/{docId} {
      allow read, write: if isAdmin();
    }

    // TRYOUTS
    // Coaches read/manage everything. A signed-in parent may read and edit the
    // registrations they submitted, matched on their verified sign-in email
    // (list queries must filter email == their own). Public may create.
    match /tryout-applicants/{applicantId} {
      allow read: if isCoach() || (
        isAuth() && resource.data.email == request.auth.token.email
      );
      allow create: if true;
      allow update: if isCoach() || (
        isAuth() && resource.data.email == request.auth.token.email &&
        // Parents may edit details but never the review pipeline fields.
        request.resource.data.status == resource.data.status &&
        request.resource.data.email == resource.data.email
      );

      match /evaluations/{evaluationId} {
        allow read, write: if isCoach();
      }
    }

    // TRYOUT SESSIONS (dates/locations offered) — public so the tryout signup
    // page can show them; coaches/admins manage them.
    match /tryoutSessions/{docId} {
      allow read: if true;
      allow write: if isCoach();
    }

    // COMMUNICATIONS
    match /communications/{messageId} {
      allow create: if isAdmin();
      allow read: if isAuth() && request.auth.uid in resource.data.recipients;
      allow write: if false;
    }

    // SPONSORS
    match /sponsors/{docId} {
      allow read: if true;
      // Only admins and sponsor-role users can create; webhook creates via Admin SDK
      allow create: if isAdmin() || isSponsor();
      allow update: if isAdmin() || (isSponsor() && resource.data.userId == request.auth.uid);
      allow delete: if isAdmin();
    }

    // SCHEDULES / EVENTS
    match /schedules/{docId} {
      allow read: if true;
      allow write: if isCoach();
    }

    // ANNOUNCEMENTS
    match /announcements/{docId} {
      allow read: if isAuth();
      allow write: if isCoach();
    }

    // CONVERSATIONS & MESSAGES
    match /conversations/{convoId} {
      allow read: if isAuth() && request.auth.uid in resource.data.participantIds;
      // Creator must be a participant in the conversation
      allow create: if isAuth() && request.auth.uid in request.resource.data.participantIds;
      allow update: if isAuth() && request.auth.uid in resource.data.participantIds;

      match /messages/{messageId} {
        allow read, create: if isAuth() && request.auth.uid in get(/databases/$(database)/documents/conversations/$(convoId)).data.participantIds;
      }
    }

    // DOCUMENTS (role-based visibility)
    match /documents/{docId} {
      allow read: if isAuth() && (
        isAdmin() ||
        (isCoach() && resource.data.visibility in ['public', 'parent', 'coach', 'team']) ||
        (hasRole('parent') && resource.data.visibility in ['public', 'parent']) ||
        resource.data.visibility == 'public'
      );
      allow write: if isCoach();
    }

    // MEDIA
    match /media/{docId} {
      allow read: if true;
      allow write: if isCoach();
    }

    // TOURNAMENTS
    match /tournaments/{docId} {
      allow read: if isAuth();
      allow write: if isAdmin();
    }

    // VOLUNTEERS
    match /volunteers/{docId} {
      allow read: if isAuth();
      allow write: if isCoach();
    }

    // FUNDRAISERS
    match /fundraisers/{docId} {
      allow read: if isAuth();
      allow write: if isAdmin();
    }

    // PLAYER FINANCES
    // Coaches/admins read all; parents read their linked children's records.
    // Sponsors no longer get blanket read of every player's finances — the
    // sponsor "pay a player" flow uses the getPlayerFinanceSummary Cloud
    // Function, which returns only a minimal balance summary.
    match /playerFinances/{docId} {
      allow read: if isCoach() || (
        isAuth() && hasRole('parent') &&
        resource.data.playerId in getUserData(request.auth.uid).linkedPlayerIds
      );
      allow write: if isAdmin();
    }

    // EXPENSES
    match /expenses/{docId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // INCOME
    // Sponsors can read their own sponsorship income records
    match /income/{docId} {
      allow read: if isAdmin() || (
        isSponsor() && resource.data.category == 'sponsorships'
      );
      allow write: if isAdmin();
    }

    // COST ASSUMPTIONS
    // The 'global' document is publicly readable for the pricing page;
    // all other cost docs require admin access.
    match /costs/global {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /costs/{docId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // BUDGETS
    match /budgets/{docId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // ACCOUNTS
    match /accounts/{docId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // VENDORS
    match /vendors/{docId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // PLAYER METRICS
    match /playerMetrics/{docId} {
      allow read: if isCoach();
      allow write: if isCoach();
    }

    // SCHOLARSHIPS
    match /scholarships/{docId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // EQUIPMENT
    match /equipment/{docId} {
      allow read: if isCoach();
      allow write: if isAdmin();
    }

    // INVOICE TOKENS (QR code payments)
    // NOT publicly listable — the docs hold every child's name, fee breakdown,
    // scholarship amount, and the secret payment token. The public payment page
    // resolves a single invoice via the getInvoiceByToken Cloud Function.
    // Parents may read their linked children's invoices; admins read all.
    match /invoiceTokens/{docId} {
      allow read: if isAdmin() || (
        isAuth() && hasRole('parent') &&
        resource.data.playerId in getUserData(request.auth.uid).linkedPlayerIds
      );
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // MAIL (receipt emails via Firebase Trigger Email extension)
    match /mail/{docId} {
      allow create: if isAdmin();
      allow read: if isAdmin();
    }

    // RECEIPTS (fallback receipt storage)
    match /receipts/{docId} {
      allow create: if isAdmin();
      allow read: if isAdmin();
    }

    // CONTACT FORM SUBMISSIONS
    match /contactSubmissions/{docId} {
      allow read: if isAdmin();
      allow create: if true;
    }

    // COACH APPLICATIONS — public can apply; only admins review/update.
    match /coachApplications/{docId} {
      allow create: if true;
      allow read, update: if isAdmin();
      allow delete: if isAdmin();
    }

    // APP SETTINGS
    match /appSettings/{docId} {
      allow read: if isAuth();
      allow write: if isAdmin();
    }

    // ADMIN NOTIFICATIONS (content moderation alerts)
    match /adminNotifications/{docId} {
      allow read, write: if isAdmin();
    }

    // FAILED STRIPE WEBHOOK EVENTS (dead-letter; written by Cloud Function via
    // Admin SDK). Admins read/update to reconcile; no client create.
    match /failedStripeWebhookEvents/{docId} {
      allow read, update: if isAdmin();
      allow create, delete: if false;
    }

    // SURVEYS — questions are readable by any signed-in user (so parents can
    // fill them out). Coaches and admins can create surveys; a survey can be
    // edited/deleted by an admin or by the coach who created it.
    match /surveys/{docId} {
      allow read: if isAuth();
      allow create: if isCoach();
      allow update, delete: if isAdmin() || (isCoach() && resource.data.createdBy == request.auth.uid);
    }

    // SURVEY RESPONSES (full) — private. Any signed-in user may SUBMIT (create),
    // but the complete answer set is readable ONLY by admins/master-admins.
    // Immutable once submitted.
    match /surveyResponses/{docId} {
      allow create: if isAuth();
      allow read: if isAdmin();
      allow update: if false;
      allow delete: if isMasterAdmin();
    }

    // SURVEY RESPONSES (coach-visible projection) — contains only the answers to
    // questions marked visible-to-coaches. Readable by admins and by the coach
    // who created the survey (so coaches get their own feedback). Coaches can
    // never see the full/admin-only answers, which live in surveyResponses.
    match /surveyResponsesCoach/{docId} {
      allow create: if isAuth();
      allow read: if isAdmin() || (isCoach() && resource.data.surveyCreatedBy == request.auth.uid);
      allow update: if false;
      allow delete: if isAdmin();
    }

    // HOMEPAGE POSTS (public-facing content)
    match /homepagePosts/{docId} {
      allow read: if true;
      allow create: if isCoach();
      allow update: if isCoach();
      allow delete: if isAdmin();
    }

    // GAMECHANGER DATA
    match /gcStats/{docId} {
      allow read: if isCoach();
      allow write: if isAdmin();
    }

    match /gcGames/{docId} {
      allow read: if isCoach();
      allow write: if isAdmin();
    }

    // COST ITEMS (3-tier cost management)
    match /costItems/{docId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // CHART OF ACCOUNTS
    match /chartOfAccounts/{docId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // GENERAL LEDGER
    match /generalLedger/{docId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // TEAM INVOICE BATCHES
    match /teamInvoiceBatches/{docId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // DONORS
    match /donors/{docId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // DONOR RECEIPTS
    match /donorReceipts/{docId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // BOARD MEETINGS
    match /boardMeetings/{docId} {
      allow read: if isCoach();
      allow write: if isAdmin();
    }

    // GOVERNANCE DOCUMENTS
    match /governanceDocuments/{docId} {
      allow read: if isCoach();
      allow write: if isAdmin();
    }

    // VOLUNTEER HOURS
    match /volunteerHours/{docId} {
      allow read: if isCoach();
      allow write: if isCoach();
    }

    // BACKGROUND CHECKS
    match /backgroundChecks/{docId} {
      allow read: if isCoach();
      allow write: if isAdmin();
    }

    // FORM 990 DATA
    match /form990Data/{docId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // TEAM STATS (imported via scripts, read by coaches+)
    match /teamStats/{docId} {
      allow read: if isCoach();
      allow write: if isAdmin();
    }

    // PASSWORD RESETS (server-only via Admin SDK — deny all client access)
    match /passwordResets/{docId} {
      allow read, write: if false;
    }

    // RATE LIMITS (server-only via Admin SDK — deny all client access)
    match /rateLimits/{docId} {
      allow read, write: if false;
    }

    // FISCAL YEAR CLOSES (admin only — year-end closing records)
    match /fiscalYearCloses/{docId} {
      allow read: if isAdmin();
      allow write: if isMasterAdmin();
    }

    // FIXED ASSETS (admin only — depreciation tracking)
    match /fixedAssets/{docId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // BANK RECONCILIATIONS (admin only)
    match /bankReconciliations/{docId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }
  }
}
