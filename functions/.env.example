# Cloud Functions runtime configuration.
#
# functions.config() (Cloud Runtime Config) was shut down by Google at the end
# of 2025, so all secrets are now read from environment variables. Firebase
# automatically loads functions/.env at deploy and emulator runtime.
#
# Copy this file to functions/.env and fill in real values. functions/.env is
# gitignored — never commit real secrets.

# Stripe
STRIPE_SECRET_KEY=sk_live_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Gmail SMTP (App Password, not the account password)
SMTP_USER=tcwavessoftball@gmail.com
SMTP_PASS=your_gmail_app_password

# Google Drive service account (the full service-account JSON on ONE line)
GOOGLE_DRIVE_SERVICE_ACCOUNT={"type":"service_account", ...}

# Public site URL used in emails and password-reset / invite links
SITE_URL=https://nmwaves.com
